{
  "name": "@mocha/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mocha-mcp": "./dist/mocha-mcp.js"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/mocha-mcp.js --banner:js=\"import{createRequire}from'node:module';const require=createRequire(import.meta.url);\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@mocha/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
